---
import { service } from "../data/service";
---

<section id="service" class="border-t border-[var(--color-border)] dark:border-[var(--color-border-dark)] pt-10 mt-16">
  <h2 class="text-base font-semibold tracking-tight">Recognition &amp; service</h2>

  <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
    {
      service.map((entry) => (
        <li class="grid grid-cols-[84px_1fr] gap-4 py-4 first:pt-0">
          <span class="tabular-nums text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] pt-0.5">
            {entry.date}
          </span>
          <div class="min-w-0">
            <p class="leading-[1.5] text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
              {entry.url ? (
                <a
                  href={entry.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[var(--color-accent)] dark:hover:text-[var(--color-accent-dark)] transition-colors"
                >
                  {entry.role} — {entry.organization}
                </a>
              ) : (
                <>
                  {entry.role} — {entry.organization}
                </>
              )}
            </p>
            {entry.detail && (
              <p class="mt-1 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">{entry.detail}</p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
