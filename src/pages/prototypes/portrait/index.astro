---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import portrait from "../../../assets/portrait.jpg";

const variants = [
  {
    id: "a",
    name: "Editorial",
    summary:
      "Serif display type (Newsreader) on warm paper tones, with the portrait set large beside the name. The most visible change in character.",
    touches: "Hero, section headings, page background",
  },
  {
    id: "b",
    name: "Cover",
    summary:
      "Full-bleed photograph as a magazine cover, name and links set in white over the image. Everything below stays as it is today.",
    touches: "Hero only (full-bleed band)",
  },
  {
    id: "c",
    name: "Sidebar",
    summary:
      "Two-column layout. Portrait, name, and links live in a sticky left rail; the content scrolls on the right. Reads like a well-kept academic page.",
    touches: "Page structure (wider container)",
  },
  {
    id: "d",
    name: "Refined",
    summary:
      "Same single-column structure as today, upgraded: larger squircle portrait with a soft ring, bigger name, roomier spacing, filled link pills. Lowest-risk option.",
    touches: "Hero only",
  },
] as const;

const muted = "text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]";
const border = "border-[var(--color-border)] dark:border-[var(--color-border-dark)]";
---

<Layout title="Portrait prototypes · Sanjeev Suresh" description="Layout prototypes for the new portrait.">
  <section class="pt-12 sm:pt-16">
    <p class={muted}>Prototype page — not linked from the homepage</p>
    <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight">Portrait &amp; hero prototypes</h1>
    <p class="mt-2 leading-[1.55]">
      One new photograph, four treatments. Each link opens a full homepage so you can judge it in context, in light and
      dark mode, on desktop and phone.
    </p>
  </section>

  <section class={`mt-10 border-t ${border} pt-8 flex items-start gap-6`}>
    <Image
      src={portrait}
      alt="Portrait of Sanjeev Suresh"
      width={160}
      densities={[1, 2]}
      class={`w-[96px] sm:w-[120px] h-auto rounded-md border ${border}`}
    />
    <div class={muted}>
      <p>Source: <code>src/assets/portrait.jpg</code> · 1500 × 2000 · 3:4</p>
      <p class="mt-1">
        Served through Astro&rsquo;s image pipeline (AVIF + WebP derivatives, responsive <code>srcset</code>), replacing
        the 480 × 480 <code>public/headshot.jpg</code>.
      </p>
    </div>
  </section>

  <ul class={`mt-10 border-t ${border} divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]`}>
    {
      variants.map((v) => (
        <li class="py-6">
          <a
            href={`/prototypes/portrait/${v.id}`}
            class="group grid grid-cols-[32px_1fr] gap-4 hover:text-[var(--color-accent)] dark:hover:text-[var(--color-accent-dark)] transition-colors"
          >
            <span class="text-2xl font-semibold tabular-nums tracking-tight uppercase">{v.id}</span>
            <span class="min-w-0">
              <span class="block text-lg font-semibold tracking-tight">
                {v.name}
                <span class="inline-block translate-x-0 group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="mt-1 block leading-[1.55] text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
                {v.summary}
              </span>
              <span class={`mt-2 block ${muted}`}>Touches: {v.touches}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
