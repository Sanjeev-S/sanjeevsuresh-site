---
import { Picture } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import About from "../../../components/About.astro";
import SelectedWork from "../../../components/SelectedWork.astro";
import RecognitionService from "../../../components/RecognitionService.astro";
import Events from "../../../components/Events.astro";
import Media from "../../../components/Media.astro";
import Publications from "../../../components/Publications.astro";
import ProtoBar from "./_ProtoBar.astro";
import portrait from "../../../assets/portrait.jpg";
import { site } from "../../../data/site";

const links = [
  { label: "Email", href: `mailto:${site.email}`, external: false },
  { label: "LinkedIn", href: site.links.linkedin, external: true },
  { label: "GitHub", href: site.links.github, external: true },
];

const pill =
  "inline-flex items-center rounded-full border border-[var(--color-border)] dark:border-[var(--color-border-dark)] bg-[var(--color-card)] dark:bg-[var(--color-card-dark)] px-3.5 py-1.5 font-medium shadow-[0_1px_0_rgba(0,0,0,0.03)] transition-[border-color,transform] hover:border-[var(--color-accent)] dark:hover:border-[var(--color-accent-dark)] hover:-translate-y-px";
---

<Layout title="Prototype D · Refined · Sanjeev Suresh" description="Portrait prototype D: refined.">
  <div class="pt-6"><ProtoBar current="d" name="Refined" /></div>

  <section class="pt-14 sm:pt-20">
    <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-8 sm:gap-12">
      <div class="flex-1 min-w-0">
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-[-0.03em] leading-[1.05] text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
          {site.name}
        </h1>
        <p class="mt-4 text-lg leading-snug text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
          {site.jobTitle} at {site.employer}
        </p>
        <p class="mt-2 max-w-[44ch] leading-[1.55] text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          {site.tagline}
        </p>

        <ul class="mt-7 flex flex-wrap gap-2 text-sm">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? "_blank" : undefined}
                  rel={l.external ? "me noopener noreferrer" : undefined}
                  class={pill}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <Picture
        src={portrait}
        formats={["avif", "webp"]}
        widths={[136, 176, 272, 352]}
        sizes="(min-width: 640px) 176px, 136px"
        alt={`Portrait of ${site.name}`}
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: "shrink-0" }}
        class="size-[136px] sm:size-[176px] object-cover object-top rounded-[30%] ring-1 ring-[var(--color-border)] dark:ring-[var(--color-border-dark)] ring-offset-4 ring-offset-[var(--color-bg)] dark:ring-offset-[var(--color-bg-dark)] shadow-[0_16px_40px_-20px_rgba(0,0,0,0.4)]"
      />
    </div>
  </section>

  <About />
  <SelectedWork />
  <RecognitionService />
  <Events />
  <Media />
  <Publications />
</Layout>
