---
import Layout from "../../layouts/Layout.astro";
import { events } from "../../data/events";

const linkClass =
  "hover:text-[var(--color-accent)] dark:hover:text-[var(--color-accent-dark)] transition-colors";
const muted = "text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]";
const border = "border-t border-[var(--color-border)] dark:border-[var(--color-border-dark)]";
---

<Layout title="Events prototypes · Sanjeev Suresh" description="Events section prototypes including title-only.">
  <section class="pt-12 sm:pt-16">
    <p class={muted}>Prototype page — not linked from the homepage</p>
    <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight">Events · how much detail?</h1>
    <p class="mt-2 leading-[1.55]">
      You’re already listed as AAIF Ambassador under Recognition &amp; service. These variants ask whether Events needs any credit line at all.
    </p>
    <p class={`mt-3 ${muted}`}>
      <a href="/prototypes/homepage" class={linkClass}>Homepage context</a>
      ·
      <a href="/prototypes/homepage-bare" class={linkClass}>Homepage with title-only Events</a>
    </p>
  </section>

  <!-- Bare: title only -->
  <section id="proto-bare" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>A · Title only (new)</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events</h2>
    <p class={`mt-2 ${muted}`}>
      Just the nights. No Co-host, no city. Affiliation is implied by the Ambassador line above.
    </p>

    <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
      {
        events.map((e) => (
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 first:pt-0">
            <span class={`tabular-nums ${muted} pt-0.5`}>
              {e.month} {e.year}
            </span>
            <div class="min-w-0">
              <p class="leading-[1.5]">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {e.title}
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Bare + AAIF once in intro -->
  <section id="proto-bare-intro" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>B · Title only + one AAIF line</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events</h2>
    <p class={`mt-2 ${muted}`}>Community events with Agentic AI Foundation.</p>

    <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
      {
        events.map((e) => (
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 first:pt-0">
            <span class={`tabular-nums ${muted} pt-0.5`}>
              {e.month} {e.year}
            </span>
            <div class="min-w-0">
              <p class="leading-[1.5]">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {e.title}
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Previous recommended for contrast -->
  <section id="proto-recommended" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>C · Previous recommended (for contrast)</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events</h2>
    <p class={`mt-2 ${muted}`}>Co-host · city on every row — more explicit, more redundant with Recognition.</p>

    <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
      {
        events.map((e) => (
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 first:pt-0">
            <span class={`tabular-nums ${muted} pt-0.5`}>
              {e.month} {e.year}
            </span>
            <div class="min-w-0">
              <p class="leading-[1.5]">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {e.title}
                </a>
              </p>
              <p class={`mt-1 ${muted}`}>
                {e.role} · {e.city}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
