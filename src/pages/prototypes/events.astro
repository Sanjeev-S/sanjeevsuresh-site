---
import Layout from "../../layouts/Layout.astro";
import { events } from "../../data/events";

const linkClass =
  "hover:text-[var(--color-accent)] dark:hover:text-[var(--color-accent-dark)] transition-colors";
const muted = "text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]";
const border = "border-t border-[var(--color-border)] dark:border-[var(--color-border-dark)]";
---

<Layout title="Events prototypes · Sanjeev Suresh" description="Reference-inspired Events section prototypes.">
  <section class="pt-12 sm:pt-16">
    <p class={muted}>Prototype page — not linked from the homepage</p>
    <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight">Events · reference-inspired</h1>
    <p class="mt-2 leading-[1.55]">
      Adapted from
      <a href="https://rohit102497.github.io/events/" target="_blank" rel="noopener noreferrer" class={linkClass}>Rohit Agarwal</a>,
      <a href="https://chngr.github.io/organization.html" target="_blank" rel="noopener noreferrer" class={linkClass}>Raymond Cheng</a>,
      and your existing Media / Recognition lists. Credit uses <strong>Co-host</strong> (Luma “Hosted By”).
    </p>
    <p class={`mt-3 ${muted}`}>
      Also see the
      <a href="/prototypes/homepage" class={linkClass}>homepage-in-context prototype</a>.
    </p>
  </section>

  <!-- 1: Recommended — Rohit/Raymond + your Media list -->
  <section id="proto-recommended" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>1 · Recommended</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events</h2>
    <p class={`mt-2 ${muted}`}>
      Event title first (like Rohit/Raymond). Role + city on the second line (like your Media section). Month + year.
    </p>

    <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
      {
        events.map((e) => (
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 first:pt-0">
            <span class={`tabular-nums ${muted} pt-0.5`}>
              {e.month} {e.year}
            </span>
            <div class="min-w-0">
              <p class="leading-[1.5]">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {e.title}
                </a>
              </p>
              <p class={`mt-1 ${muted}`}>
                {e.role} · {e.city}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 2: Raymond-minimal — date then title, role inline -->
  <section id="proto-raymond" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>2 · Raymond-minimal</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events</h2>
    <p class={`mt-2 ${muted}`}>
      Single line per event: date — role · title. Dense, academic CV style.
    </p>

    <ul class="mt-4 space-y-3">
      {
        events.map((e) => (
          <li class="leading-[1.55]">
            <span class={`tabular-nums ${muted}`}>
              {e.month} {e.year}
            </span>
            <span class={muted}> — {e.role} · </span>
            <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {e.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3: Rohit-rich — title + venue + note -->
  <section id="proto-rohit" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>3 · Rohit-rich</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events</h2>
    <p class={`mt-2 ${muted}`}>
      More context: role · venue · city, plus a one-line note. Closer to Rohit’s featured cards, without cards.
    </p>

    <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
      {
        events.map((e) => (
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 first:pt-0">
            <span class={`tabular-nums ${muted} pt-0.5`}>
              {e.month} {e.year}
            </span>
            <div class="min-w-0">
              <p class="leading-[1.5]">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {e.title}
                </a>
              </p>
              <p class={`mt-1 ${muted}`}>
                {e.role} · {e.venue} · {e.city}
              </p>
              {e.note && <p class={`mt-0.5 ${muted}`}>{e.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 4: Role in section heading only (Xiaoqing-style) -->
  <section id="proto-heading" class={`${border} pt-10 mt-16`}>
    <p class={`${muted} uppercase tracking-wide text-xs`}>4 · Role in heading</p>
    <h2 class="mt-1 text-base font-semibold tracking-tight">Events hosted</h2>
    <p class={`mt-2 ${muted}`}>
      Role implied by the heading — list is just title + place. Quieter credit.
    </p>

    <ul class="mt-4 divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
      {
        events.map((e) => (
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 first:pt-0">
            <span class={`tabular-nums ${muted} pt-0.5`}>
              {e.month} {e.year}
            </span>
            <div class="min-w-0">
              <p class="leading-[1.5]">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {e.title}
                </a>
              </p>
              <p class={`mt-1 ${muted}`}>{e.city}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
