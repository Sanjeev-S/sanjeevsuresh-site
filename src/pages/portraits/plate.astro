---
import Layout from "../../layouts/Layout.astro";
import ContactLinks from "../../components/portrait/ContactLinks.astro";
import Portrait from "../../components/portrait/Portrait.astro";
import SiteSections from "../../components/portrait/SiteSections.astro";
import StudyNav from "../../components/portrait/StudyNav.astro";
import { site } from "../../data/site";
---

<Layout
  title="Plate · Sanjeev Suresh"
  description="Portrait study: a mounted studio photograph in the current page column."
>
  <div class="pt-8 sm:pt-10">
    <StudyNav current="plate" />
  </div>

  <header class="pt-10 sm:pt-12">
    <div class="w-full max-w-[22rem] border border-black/10 bg-[var(--color-bg)] p-2 sm:p-2.5 dark:border-white/15 dark:bg-[var(--color-bg-dark)]">
      <Portrait width={480} sizes="(min-width: 640px) 320px, 85vw" priority class="w-full" />
    </div>
    <h1 class="mt-8 text-4xl font-semibold tracking-tight text-balance">{site.name}</h1>
    <p class="mt-3 text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
      {site.jobTitle} at {site.employer}
    </p>
    <p class="mt-3 max-w-md leading-[1.55] text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      {site.tagline}
    </p>
    <div class="mt-6">
      <ContactLinks />
    </div>
  </header>

  <SiteSections />
</Layout>
