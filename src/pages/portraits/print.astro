---
import "@fontsource/newsreader/latin-500.css";
import "@fontsource/newsreader/latin-400-italic.css";

import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import ContactLinks from "../../components/portrait/ContactLinks.astro";
import Portrait from "../../components/portrait/Portrait.astro";
import SiteSections from "../../components/portrait/SiteSections.astro";
import StudyNav from "../../components/portrait/StudyNav.astro";
import { site } from "../../data/site";
---

<Layout
  title="Print · Sanjeev Suresh"
  description="Portrait study: the studio photograph set beside the name on warm paper."
  tone="paper"
  frame="bleed"
>
  <div class="mx-auto max-w-[68rem] px-5 pb-24 sm:px-8">
    <div class="pt-8 sm:pt-10">
      <StudyNav current="print" />
    </div>

    <header class="mt-12 grid items-end gap-10 sm:mt-16 lg:grid-cols-[minmax(0,1fr)_minmax(16rem,26rem)] lg:gap-x-20">
      <figure class="order-1 w-full max-w-[26rem] lg:order-2 lg:max-w-none">
        <Portrait
          width={640}
          sizes="(min-width: 1024px) 416px, 90vw"
          priority
          class="w-full border border-black/10 dark:border-white/15"
        />
      </figure>

      <div class="order-2 max-w-xl lg:order-1">
        <p
          class="text-[0.72rem] font-medium uppercase tracking-[0.18em] text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          {site.employer}
        </p>
        <h1
          class="mt-3 font-serif text-[3.15rem] font-medium leading-[0.96] tracking-[-0.03em] text-balance sm:text-6xl lg:text-[4.25rem]"
        >
          {site.name}
        </h1>
        <p class="mt-4 text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">{site.jobTitle}</p>
        <p
          class="mt-5 max-w-[34ch] font-serif text-xl italic leading-snug text-[var(--color-fg)] sm:text-[1.35rem] dark:text-[var(--color-fg-dark)]"
        >
          {site.tagline}
        </p>
        <div class="mt-8">
          <ContactLinks />
        </div>
      </div>
    </header>

    <div class="max-w-xl">
      <SiteSections />
      <Footer />
    </div>
  </div>
</Layout>
